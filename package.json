{
  "name": "omar-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "vite:build": "vite build",
    "build": "bun install --frozen-lockfile && bun run typecheck && bun run vite:build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "bun run vite:build && bunx wrangler pages dev dist",
    "deploy": "bun run build && bunx wrangler pages deploy dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
